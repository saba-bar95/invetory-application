<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title }) %>
  </head>
  <body>
    <main class="container">
      <a
        href="<%= item && item.id ? `/items/${item.id}` : (item?.category_id ? `/categories/${item.category_id}` : '/') %>"
        >Cancel</a
      >
      <h1><%= title %></h1>

      <% if (errors && errors.length) { %>
        <ul class="error-list">
          <% errors.forEach((error) => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      <% } %>

      <form action="<%= action %>" method="POST">
        <label>
          Name
          <input
            type="text"
            name="name"
            required
            maxlength="150"
            value="<%= item?.name || '' %>"
          />
        </label>
        <label>
          Description
          <textarea name="description" rows="3" maxlength="1000"
            ><%= item?.description || '' %></textarea
          >
        </label>
        <label>
          Quantity
          <input
            type="number"
            name="quantity"
            required
            min="0"
            step="1"
            value="<%= item?.quantity ?? 0 %>"
          />
        </label>
        <label>
          Price
          <input
            type="number"
            name="price"
            required
            min="0"
            step="0.01"
            value="<%= item?.price ?? '0.00' %>"
          />
        </label>
        <label>
          Category
          <select name="category_id" required>
            <option value="" disabled <%= !item?.category_id ? "selected" : "" %>>
              Select a category
            </option>
            <% categories.forEach((category) => { %>
              <option
                value="<%= category.id %>"
                <%= String(item?.category_id) === String(category.id) ? "selected" : "" %>
              >
                <%= category.name %>
              </option>
            <% }) %>
          </select>
        </label>
        <button type="submit">Save item</button>
      </form>
    </main>
  </body>
</html>
